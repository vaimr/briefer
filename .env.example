# Matrix bot credentials
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER=@transcriber_bot:example.com
MATRIX_PASSWORD=your_password
# MATRIX_ACCESS_TOKEN=...   # можно использовать токен вместо пароля

# Redis connection (override defaults if needed)
# MATRIX_REDIS_HOST=redis
# MATRIX_REDIS_PORT=6379

# Bot help text (path to file with help message for non-audio messages)
# HELP_TEXT_FILE=/etc/briefer/help.txt

# Worker settings (override defaults if needed)
# WORKER_LLM_API_URL=http://faex:8080/v1
# WORKER_LLM_MODEL_NAME=qwen3.6-a3b-mtp:35b
# WORKER_WHISPER_MODEL=large-v3
